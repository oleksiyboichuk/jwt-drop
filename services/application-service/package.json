{
  "name": "@jwt-drop/application-service",
  "version": "1.0.0",
  "private": true,
  "description": "Application Service (ECS Fargate under ALB) with local JWT validation and SQS Fan-Out listener",
  "main": "dist/server.cjs",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.714.0",
    "@aws-sdk/client-sqs": "^3.714.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.2"
  }
}
